<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.kcube</groupId>
    <artifactId>kcube-maven-goals-plugin-parent</artifactId>
    <version>1.0.1</version>
    <packaging>pom</packaging>
    <name>KCube Maven Goals (parent)</name>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <properties>
        <tycho.version>4.0.13</tycho.version>
        <eclipse.release>2023-09</eclipse.release> <!-- Eclipse 4.29 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <modules>
        <module>com.kcube.mavenview</module>
        <module>com.kcube.mavenview.tests</module>
        <module>com.kcube.mavenview.feature</module>
        <module>com.kcube.mavenview.update-site</module>
    </modules>

    <repositories>
        <repository>
            <id>eclipse-release</id>
            <layout>p2</layout>
            <url>https://download.eclipse.org/releases/${eclipse.release}</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-maven-plugin</artifactId>
                <version>${tycho.version}</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>target-platform-configuration</artifactId>
                <version>${tycho.version}</version>
                <configuration>
                    <environments>
                        <environment><os>macosx</os><ws>cocoa</ws><arch>aarch64</arch></environment>
                        <environment><os>macosx</os><ws>cocoa</ws><arch>x86_64</arch></environment>
                        <environment><os>win32</os><ws>win32</ws><arch>x86_64</arch></environment>
                        <environment><os>linux</os><ws>gtk</ws><arch>x86_64</arch></environment>
                    </environments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
